upstream openbb_backend {
  server 127.0.0.1:8000;
}

# Resolve the Connection header for WebSocket upgrades. The Workspace MCP bridge
# (/api/pro/workspace-mcp/bridge/ws) upgrades to a WebSocket; for normal requests
# $http_upgrade is empty and this maps to "close". Included files live inside the
# main nginx.conf http{} block, so this map sits at http context as required.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Record route failures and disconnects without request URLs, cookies or bodies.
log_format qopenbb_origin 'component=origin request=$request_id status=$status upstream=$upstream_status duration=$request_time';

server {
  access_log /dev/stdout qopenbb_origin;
  error_log /dev/stderr crit;
  listen ${PORT};
  server_name _;
  # Relative redirects retain the client HTTPS origin across the HTTP tunnel.
  absolute_redirect off;

  client_max_body_size 50m;

  root /usr/share/nginx/html;
  index index.html;

  # Backend reverse-proxy. The SPA's runtime config (`urls.backend = "/api"`)
  # points calls here; we strip the prefix before forwarding so the FastAPI
  # routes ("/pro/...", "/admin/...", "/login", etc.) remain unprefixed.
  location = /api { return 308 /api/; }
  location ^~ /api/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://openbb_backend;
    proxy_http_version 1.1;
    # The configured public authority/scheme survives the plain HTTP tunnel hop.
    proxy_set_header Host ${PUBLIC_HOST};
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
    proxy_set_header X-Forwarded-Prefix /api;
    # WebSocket upgrade for the Workspace MCP bridge; no-op for plain HTTP.
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # Don't buffer the MCP streamable-http (SSE) responses or the WS frames.
    proxy_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  include /etc/nginx/qopenbb-routes.conf;

  # Missing script assets must report absence instead of returning the SPA HTML.
  location ^~ /assets/ {
    try_files $uri =404;
  }

  # Catch-all SPA fallback for client-side routing.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
